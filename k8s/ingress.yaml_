apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: simpleservice-ingress
  namespace: apps
  annotations:
    # cert-manager will automatically provision certificate
    cert-manager.io/cluster-issuer: "selfsigned-issuer"  # or letsencrypt-prod
    
    # Optional: Force HTTPS redirect
    traefik.ingress.kubernetes.io/redirect-entry-point: https
spec:
  ingressClassName: traefik
  
  tls:
    - hosts:
        - simpleservice.local
      secretName: simpleservice-tls
  
  rules:
    - host: simpleservice.local
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: simpleservice
                port:
                  number: 80